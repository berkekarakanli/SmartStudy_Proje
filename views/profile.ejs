<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SmartStudy | Profil</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body{ background:#020617; color:white; font-family:'Inter',Arial,sans-serif; }
        .panel{ max-width:720px; margin:32px auto; background:rgba(30,41,59,.76); border:1px solid rgba(13,202,240,.25); border-radius:16px; padding:28px; box-sizing:border-box; }
        .form-control{ background:#0f172a; border:1px solid #334155; color:white!important; padding:12px; }
        .form-control::placeholder { color: #64748b; }
        .avatar-circle {
            width: 64px; height: 64px; border-radius: 50%;
            background: rgba(13,202,240,0.12); color:#0dcaf0;
            display:flex; align-items:center; justify-content:center;
            font-size:1.6rem; font-weight:800; flex-shrink:0;
        }
        .member-badge { display:inline-flex; align-items:center; padding:5px 12px; border-radius:999px; font-size:0.72rem; font-weight:700; background:rgba(148,163,184,0.12); color:#cbd5e1; border:1px solid rgba(148,163,184,0.25); }
        .member-badge.is-premium { background:rgba(255,193,7,0.15); color:#ffc107; border-color:rgba(255,193,7,0.4); }
        .stat-tile { background:rgba(15,23,42,.7); border:1px solid rgba(255,255,255,.08); border-radius:14px; padding:18px 8px; height:100%; text-align:center; transition:0.25s; }
        .stat-tile:hover { transform: translateY(-3px); border-color: rgba(13,202,240,0.35); }
        .stat-tile .stat-icon { font-size:1.1rem; margin-bottom:8px; opacity:0.85; }
        .stat-tile .stat-label { color:#94a3b8; font-size:0.7rem; text-transform:uppercase; letter-spacing:0.5px; display:block; margin-bottom:6px; }
        .stat-tile .stat-value { font-size:1.35rem; margin:0; font-weight:800; }
    </style>
</head>
<body>
    <main class="panel">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3">
                <span class="avatar-circle"><%= (user.ad || '?').trim().charAt(0).toUpperCase() %></span>
                <div>
                    <h1 class="h4 mb-1"><%= user.ad %></h1>
                    <span class="member-badge <%= user.level === 'Premium' ? 'is-premium' : '' %>">
                        <% if (user.level === 'Premium') { %><i class="fas fa-certificate me-1"></i><% } %><%= user.level || 'Free' %> Üye
                    </span>
                </div>
            </div>
            <a href="/dashboard" class="btn btn-outline-info">Panele Dön</a>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="stat-tile">
                    <i class="fas fa-chart-line stat-icon text-info"></i>
                    <span class="stat-label">Analiz</span>
                    <h4 class="stat-value"><%= analizCount %></h4>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-tile">
                    <i class="fas fa-book stat-icon text-danger"></i>
                    <span class="stat-label">Hata Defteri</span>
                    <h4 class="stat-value"><%= wrongCount %></h4>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-tile">
                    <i class="fas fa-stopwatch stat-icon text-warning"></i>
                    <span class="stat-label">Odak Dakikası</span>
                    <h4 class="stat-value"><%= pomodoroDakika %></h4>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-tile">
                    <i class="fas fa-user-tie stat-icon text-success"></i>
                    <span class="stat-label">Bağlı Koç</span>
                    <h4 class="stat-value"><%= kocListesi.length %></h4>
                </div>
            </div>
        </div>

        <form action="/profile" method="POST" class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Ad Soyad</label>
                <input class="form-control" name="ad" value="<%= user.ad %>" required>
            </div>
            <div class="col-md-6">
                <label class="form-label">Email</label>
                <input class="form-control" name="email" type="email" value="<%= user.email %>" required>
            </div>
            <div class="col-md-12">
                <label class="form-label">Yeni Şifre</label>
                <input class="form-control" name="newPassword" type="password" placeholder="Değiştirmek istemiyorsan boş bırak">
            </div>
            <div class="col-12 mt-4">
                <button class="btn btn-info fw-bold w-100 py-2">Değişiklikleri Kaydet</button>
            </div>
        </form>
    </main>
</body>
</html>
